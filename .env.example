DISCORD_TOKEN=your-bot-token-here
GUILD_ID=123456789012345678
ADMIN_ROLE_ID=123456789012345678
DB_PATH=/data/mentoring.db
SYNC_GLOBALLY=false

# 선택: 운영 데이터를 LearningOps 웹에 전송합니다. 비어 있으면 실행하지 않습니다.
LEARNINGOPS_SYNC_URL=
LEARNINGOPS_SYNC_TOKEN=
LEARNINGOPS_SOURCE_NAME=아산 AX
LEARNINGOPS_SYNC_INTERVAL=60

# 선택: LMS 가입 인증. URL 경로까지 입력하고 웹 API와 동일한 전용 키를 설정합니다.
LEARNINGOPS_AUTH_URL=
LEARNINGOPS_AUTH_TOKEN=
# 선택: Render 봇 하나가 모든 워크스페이스의 채널·초대·상태 보고를 처리합니다.
# 웹에서 서버 ID를 연결하며, 워크스페이스별 봇/환경변수는 추가하지 않습니다.
LEARNINGOPS_PROVISION_URL=
LEARNINGOPS_PROVISION_TOKEN=
