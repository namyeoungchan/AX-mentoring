# API와 봇이 같은 SQLite 파일을 사용해야 합니다. 경로 기준: lms-web/
BOT_DB_PATH=../data/mentoring.db
API_PORT=3001
# 운영 환경에서는 반드시 production과 16자 이상의 관리자 비밀번호를 설정하세요.
NODE_ENV=development
ADMIN_PASSWORD=
# 신뢰할 수 있는 reverse proxy 홉 수. 직접 접속은 0. 배포 구조를 확인한 후 지정합니다.
TRUST_PROXY_HOPS=0
# 운영 웹의 Origin으로 교체. Pages 사용 시 https://namyeoungchan.github.io 추가 (경로 제외).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001

# npm run sync:setup으로 생성. Render Worker에도 같은 값을 설정합니다.
LEARNINGOPS_SYNC_TOKEN=
LEARNINGOPS_SOURCE_ID=asan-ax

# npm run bot:setup으로 키 생성. 실제 가입 허용 서버 ID를 함께 설정하세요.
LEARNINGOPS_AUTH_TOKEN=
LEARNINGOPS_AUTH_GUILD_ID=
LEARNINGOPS_PROVISION_TOKEN=

# 브라우저에 공개되는 빌드 설정입니다. 비밀값을 넣지 마세요.
# Pages에서는 Repository Variables에 API의 HTTPS Origin만 설정합니다.
VITE_API_BASE_URL=
VITE_APP_MODE=api
