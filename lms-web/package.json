{
  "name": "lms-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.mjs\" \"vite\"",
    "dev:web": "vite",
    "dev:background": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "start": "node server/index.mjs",
    "sync:setup": "node scripts/setup-render-sync.mjs",
    "bot:setup": "node scripts/setup-bot-integrations.mjs",
    "account:reset": "node scripts/reset-account.mjs",
    "test": "node --test server/attendance.test.mjs server/store.test.mjs server/render-sync.test.mjs server/auth.test.mjs server/provision.test.mjs server/workspaces.test.mjs server/admissions.test.mjs server/origins.test.mjs server/onboarding.test.mjs server/bot-storage.test.mjs server/staff-flow.test.mjs server/workspace-verification.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "build:pages": "node scripts/build-pages.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
